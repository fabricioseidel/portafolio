{
  "name": "portafolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portafolio modular y de código abierto: todo el contenido en un archivo validado, editable desde un panel con GitHub.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx serve@14 out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run tests/content.test.ts",
    "schema": "node scripts/gen-schema.mts",
    "content:sync": "node scripts/content-sync.mjs",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
