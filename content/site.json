            "code": "// Las escrituras se encolan y se reintentan al volver la conexión\nexport async function enqueue(op: Operation) {\n  await db.outbox.add({ ...op, status: 'pending', attempts: 0 });\n}\n\nexport async function flush() {\n  for (const op of await db.outbox.orderBy('createdAt').toArray()) {\n    const ok = await send(op).then(() => true, () => false);\n    if (ok) await db.outbox.delete(op.id);\n  }\n}"
